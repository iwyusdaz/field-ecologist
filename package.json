{
  "name": "field-ecologist",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "description": "Design a sampling plan for a realistic meadow, place quadrats, identify and count species, then see the meadow's true population and discover how your design choices biased your estimate.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-attribution.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:subpath": "playwright test tests/sub-path.spec.js",
    "check:a11y": "playwright test tests/a11y.spec.js",
    "poster": "node scripts/render-poster.mjs",
    "attribution": "node scripts/gen-attribution.mjs",
    "assets:v3": "node scripts/fetch-v3-assets.mjs && node scripts/build-v3-own-assets.mjs && node scripts/gen-attribution.mjs",
    "check:assets": "node scripts/check-v3-assets.mjs"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
